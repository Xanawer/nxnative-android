# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
__pycache__/
# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv
# Android host build (dm/android/cmake/build.sh) and the app (dm/android/app/build_app.sh)
dm/android/cmake/build/
dm/android/cmake/build-vkn/
dm/android/app/build/
# The Android NSP script's output and work folders (scripts/build_apk_from_nsp.py: <NSP folder>/<id>_android/ and <id>_build/ by default, which are outside the repository;
# these cover --out / --work pointed inside it by mistake). The APK holds the game's code and must never be committed
*_android/
*_build/
*.apk
*.apk.idsig
